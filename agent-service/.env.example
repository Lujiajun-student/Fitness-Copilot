# Copy this file to .env, then set DEEPSEEK_API_KEY. Do not commit .env.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
# Short calendar outline vs. detailed specialist outputs.
DEEPSEEK_PLANNER_MAX_TOKENS=4096
DEEPSEEK_MAX_TOKENS=8192
BACKEND_URL=http://localhost:8080
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STATE_TTL_SECONDS=86400
PLAN_TASK_TIMEOUT_SECONDS=1800
# Reranking is local CrossEncoder inference, never a DeepSeek completion.
RAG_RERANK_PROVIDER=cross-encoder
RAG_RERANK_URL=http://127.0.0.1:8002
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_DEVICE=cpu
RAG_RERANK_BATCH_SIZE=8
RAG_RERANK_TIMEOUT_SECONDS=120
RAG_RERANK_LOCAL_ONLY=false
RAG_INDEX_PATH=data/rag.sqlite3
